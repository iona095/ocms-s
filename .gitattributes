# Normal text handling for ordinary repository files
* text=auto

# Contracts are audited as exact bytes; do not normalize their line endings.
OpenCode*Contract*.md -text

# v1.3 byte-identity anchors (tests/v1.4/compat.test.mjs hashes working-tree
# bytes): checkout must preserve the audited LF bytes on every platform.
# Without this, a fresh Windows checkout (core.autocrlf=true) yields CRLF and
# the identity tests fail despite zero content change (RC CI 34697528778).
sync.mjs -text
ui/index.html -text

# v1.4.5 deterministic package bytes: canonicalize packaged text to LF so a
# clean checkout, git archive/export, and an existing working tree all pack
# identical bytes regardless of core.autocrlf. Narrow package-file rules only;
# contract and v1.3 anchor rules above are preserved unchanged.
LICENSE text eol=lf
README.md text eol=lf
package.json text eol=lf
cordis.patch.yml text eol=lf
dsh/client.mjs text eol=lf
dsh/client.js text eol=lf
dsh/host.mjs text eol=lf
dsh/lifecycle.mjs text eol=lf
ui.mjs text eol=lf

# v1.4.6-rc5 byte-pinned profile sources (contract v1.4.6-rc5 §5 Q3): T18 S1/S2
# and T19 accepted-S1 hash the working-tree bytes, so checkout must preserve
# the audited LF bytes on every platform (Windows runners check out CRLF
# without this; CI run 38363626182). Narrow pinned-file rules only.
profile/target-resolver.mjs text eol=lf
profile/config-reader.mjs text eol=lf
profile/surgical-render.mjs text eol=lf
profile/plan-builder.mjs text eol=lf
profile/commit.mjs text eol=lf
profile/live-attestation.mjs text eol=lf
profile/preview-session.mjs text eol=lf
tests/profile-target/helpers.mjs text eol=lf
tests/profile-target/target-admission.test.mjs text eol=lf
tests/profile-target/boundary.test.mjs text eol=lf
tests/profile-acceptance/env02-native.test.mjs text eol=lf

# v1.4.7-rc1 captured docs fixtures (contract v1.4.7-rc1 G4): the G4 test hashes
# the working-tree bytes against the recorded capture SHAs, so checkout must
# preserve exact bytes on every platform. Same treatment as contracts above.
tests/v1.4.7-rc1/fixtures/*.html -text

# OCMS-S NB1 captured docs fixtures (2026-10-15): hash the working-tree
# bytes, so checkout must preserve exact bytes on every platform.
tests/nb1-inference-bases/fixtures/*.html -text
